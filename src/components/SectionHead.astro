---
interface Props {
  title: string;
  en?: string;
  icon?: string;
  href?: string;
  linkLabel?: string;
}

const { title, en, icon = '✦', href, linkLabel = '查看全部' } = Astro.props;
---

<div class="section-head">
  <h2 class="section-head__title">
    <span class="section-head__icon" aria-hidden="true">{icon}</span>
    {title}
    {en && <small aria-hidden="true">{en}</small>}
  </h2>
  {href && (
    <a class="section-head__link" href={href}>
      {linkLabel} <span aria-hidden="true">→</span>
    </a>
  )}
</div>