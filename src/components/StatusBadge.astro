---
import type { WorkStatus } from '../types';

interface Props {
  status: WorkStatus | string;
  class?: string;
}

const { status, class: className = '' } = Astro.props;

const map: Record<string, { label: string; modifier: string }> = {
  完成: { label: '完成', modifier: 'done' },
  制作中: { label: '制作中', modifier: 'wip' },
  构思中: { label: '构思中', modifier: 'idea' },
  暂停: { label: '暂停', modifier: 'paused' },
};

const item = map[status] ?? { label: status, modifier: 'done' };
---

<span class:list={['status-badge', `status-badge--${item.modifier}`, className]}>
  <i aria-hidden="true"></i>{item.label}
</span>