---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { isPublished, formatDate } from '../../utils';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import WindowFrame from '../../components/WindowFrame.astro';

export async function getStaticPaths() {
  const works = await getCollection('works', isPublished);
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { Content } = await render(work);
const cover = work.data.cover ?? '/img/covers/default.png';
---

<BaseLayout
  title={work.data.title}
  description={work.data.description}
  image={cover}
  type="article"
>
  <Breadcrumb items={[{ label: '作品集', href: '/works/' }, { label: work.data.title }]} />

  <div class="work-detail__cover">
    <img src={cover} alt={work.data.title} width="720" height="309" />
  </div>

  <header class="work-detail__head">
    <p class="work-detail__kicker">WORK ／ {formatDate(work.data.date)} 起工</p>
    <h1 class="work-detail__title">{work.data.title}</h1>
    <p class="work-detail__tagline">{work.data.tagline}</p>
  </header>

  <div class="work-layout">
    <div class="work-detail__content">
      <div class="prose">
        <Content />
      </div>
    </div>

    <aside class="work-info">
      <WindowFrame title="制作资料" icon="◈">
        <dl>
          <div>
            <dt>状态</dt>
            <dd><StatusBadge status={work.data.status} /></dd>
          </div>
          <div>
            <dt>起工</dt>
            <dd>{formatDate(work.data.date)}</dd>
          </div>
          {work.data.stack.length > 0 && (
            <div>
              <dt>技术栈</dt>
              <dd>{work.data.stack.join(' ／ ')}</dd>
            </div>
          )}
          {work.data.tags.length > 0 && (
            <div>
              <dt>标签</dt>
              <dd>{work.data.tags.join('・')}</dd>
            </div>
          )}
        </dl>
        {
          work.data.links.length > 0 && (
            <div class="work-info__links">
              {work.data.links.map((link) => (
                <a class="pixel-btn pixel-btn--sm" href={link.url} target="_blank" rel="noopener">
                  {link.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )
        }
      </WindowFrame>

      <WindowFrame title="也说两句" icon="✎" variant="cyan">
        <p class="small muted">
          制作过程中遇到的坑大多记在
          <a href="/notes/">碎碎念</a>
          里。如果这个作品对你有用，欢迎去
          <a href="/guestbook/">留言板</a>
          说一声。
        </p>
      </WindowFrame>
    </aside>
  </div>
</BaseLayout>